#!/bin/sh
# Starts Kerberus with the bundled Python, GTK and libadwaita. Variables set here
# are saved as KERBERUS_HOST_<NAME> first, so the app can hand the host's values
# back to the Kerberos tools it runs (host_env in kerberus.py).
HERE=$(dirname "$(readlink -f "$0")")

for name in GI_TYPELIB_PATH GDK_PIXBUF_MODULE_FILE GSETTINGS_SCHEMA_DIR GSETTINGS_BACKEND GIO_MODULE_DIR GTK_EXE_PREFIX \
    XDG_DATA_DIRS; do
    if eval "[ -n \"\${$name+set}\" ]"; then
        eval "export KERBERUS_HOST_$name=\"\$$name\""
    fi
done

export KERBERUS_APPDIR="$HERE"
export GI_TYPELIB_PATH="$HERE/usr/lib/girepository-1.0"
export GSETTINGS_SCHEMA_DIR="$HERE/usr/share/glib-2.0/schemas"
export GSETTINGS_BACKEND=memory
# The host's GIO modules (dconf, gvfs) are built against its own GLib.
export GIO_MODULE_DIR="$HERE/usr/lib/gio/modules"
# Same for GTK's media, print and input method modules: look for them in here.
export GTK_EXE_PREFIX="$HERE/usr"
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# gdk-pixbuf's loader cache holds absolute paths, so write one for this mount.
cache_dir=${XDG_RUNTIME_DIR:-}
if [ -z "$cache_dir" ] || [ ! -w "$cache_dir" ]; then
    cache_dir=$(mktemp -d)
fi
export GDK_PIXBUF_MODULE_FILE="$cache_dir/kerberus-pixbuf-loaders-${HERE##*/}.cache"
sed "s|@APPDIR@|$HERE|g" "$HERE/usr/lib/gdk-pixbuf-2.0/loaders.cache.in" > "$GDK_PIXBUF_MODULE_FILE.$$" &&
    mv -f "$GDK_PIXBUF_MODULE_FILE.$$" "$GDK_PIXBUF_MODULE_FILE"

exec "$HERE/usr/bin/python3" -I "$HERE/usr/share/kerberus/kerberus.py" "$@"
